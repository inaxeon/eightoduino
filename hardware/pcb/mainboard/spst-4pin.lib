# SPST_4PIN
#
DEF SPST_4PIN SW 0 0 N Y 1 F N
F0 "SW" 0 100 70 H V C CNN
F1 "SPST_4PIN" 0 -100 70 H V C CNN
DRAW
C -150 0 50 0 0 0 N
C 150 0 50 0 0 0 N
P 2 0 0 0  -100 0  100 100 N
P 4 0 1 0  -350 100  -300 100  -300 0  -300 0 N
P 4 0 1 0  350 100  300 100  300 0  300 0 N
P 5 0 1 0  -350 -100  -300 -100  -300 0  -200 0  -200 0 N
P 5 0 1 0  350 -100  300 -100  300 0  200 0  200 0 N
X 1 1 -650 100 300 R 70 70 1 1 I
X 2 2 -650 -100 300 R 50 50 1 1 I
X 3 3 650 100 300 L 70 70 1 1 I
X 4 4 650 -100 300 L 50 50 1 1 I
ENDDRAW
ENDDEF
